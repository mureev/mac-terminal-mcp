{
  "_comment": [
    "Mac Ops policy, installed read-only next to the server by install.sh (which writes tmux's full path).",
    "v0.7: no dialogs. run and session_start commands run in the fence, a macOS sandbox: reads everywhere but",
    "deny_paths; writes only under fence_writable and temp, never to protected_paths, protected_writes matches or",
    "protected_folders; network as 'network' says. outside_sandbox=true (with a why) runs one call with no sandbox,",
    "unless allow_outside_sandbox is false. If the sandbox self-test fails, sandbox_fail decides: refuse or unsandboxed.",
    "deny_* are a speed bump for honest mistakes and obvious injections, not a sandbox; they apply outside it too.",
    "For this Mac's own folders (extra protected_folders, deny_paths), copy this file to policy.local.json (git-ignored)."
  ],
  "shell": [
    "/bin/zsh",
    "-l",
    "-c"
  ],
  "session_shell": [
    "/bin/zsh",
    "-l"
  ],
  "tmux": "tmux",
  "tmux_socket": "claude",
  "default_cwd": "~",
  "run_timeout_max_s": 45,
  "output_max_chars": 30000,
  "deny_words": [
    "sudo",
    "su",
    "doas",
    "ssh",
    "scp",
    "sftp",
    "ansible",
    "ansible-playbook",
    "ansible-inventory"
  ],
  "deny_patterns": [
    "find-generic-password",
    "find-internet-password",
    "dump-keychain",
    "\\bsecurity\\s+export\\b"
  ],
  "deny_paths": [
    "~/.ssh",
    "~/.aws",
    "~/.gnupg",
    "~/.kube",
    "~/.docker/config.json",
    "~/.netrc",
    "~/Library/Keychains",
    "~/Library/Application Support/Claude",
    "~/.config/claude-mcp",
    "~/.local/state/mac-ops",
    "~/.git-credentials",
    "~/.pypirc",
    "~/.vault-token",
    "~/.pgpass",
    "~/.my.cnf"
  ],
  "protected_folders": [],
  "state_dir": "~/.local/state/mac-ops",
  "sandbox_exec": "/usr/bin/sandbox-exec",
  "sandbox_selftest": true,
  "sandbox_fail": "refuse",
  "network": true,
  "fence_writable": [
    "~"
  ],
  "allow_outside_sandbox": true,
  "protected_paths": [
    "~/.zshrc",
    "~/.zprofile",
    "~/.zshenv",
    "~/.zlogin",
    "~/.zlogout",
    "~/.bashrc",
    "~/.bash_profile",
    "~/.profile",
    "~/.gitconfig",
    "~/.config/git",
    "~/Library/LaunchAgents",
    "/Library/LaunchAgents",
    "/Library/LaunchDaemons",
    "~/Applications",
    "~/.local/bin",
    "~/bin"
  ],
  "protected_writes": [
    "/[.]git/hooks(/|$)",
    "/[.]git/config$",
    "/[.]git$",
    "/[.]envrc$",
    "/[.]gitmodules$",
    "/[.]vscode(/|$)",
    "/[.]idea(/|$)",
    "/[.]mcp[.]json$",
    "/[.]claude/(commands|agents|skills|hooks|plugins)(/|$)",
    "/[.]claude/settings[^/]*$",
    "/[.]claude[.]json$"
  ]
}
